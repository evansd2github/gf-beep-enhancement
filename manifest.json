{
  "manifest_version": 3,
  "name": "GF Beep",
  "version": "2.0",
  "description": "Plays a sound when Glowforge is ready",
  "permissions": ["scripting"],
  "host_permissions": ["*://*.glowforge.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.glowforge.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [{
    "resources": ["sounds/ready.mp3"],
    "matches": ["*://*.glowforge.com/*"]
  }]
}
